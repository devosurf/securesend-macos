<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>SecureSend</string>
	<!-- Named without its extension, which is how Info.plist refers to an icon.
	     The file is generated from the mark by scripts/icon.sh. -->
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<key>CFBundleIdentifier</key>
	<string>dev.securesend.mac</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>SecureSend</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.3.0</string>
	<key>CFBundleVersion</key>
	<string>0.3.0</string>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>
	<key>LSUIElement</key>
	<true/>
	<key>NSHumanReadableCopyright</key>
	<string>AGPL-3.0-or-later</string>
	<!-- No NSKeyEquivalent on either service. Shift-command-Y, the obvious choice,
	     collides with Slack's status modal and the system Sticky Note service, and
	     every other free combination is somebody else's. Per-user shortcuts stay
	     available in System Settings > Keyboard > Keyboard Shortcuts > Services. -->
	<key>NSServices</key>
	<array>
		<dict>
			<key>NSMenuItem</key>
			<dict>
				<key>default</key>
				<string>Replace with SecureSend link</string>
			</dict>
			<key>NSMessage</key>
			<string>replaceSelection</string>
			<key>NSPortName</key>
			<string>SecureSend</string>
			<key>NSSendTypes</key>
			<array>
				<string>public.utf8-plain-text</string>
			</array>
			<key>NSReturnTypes</key>
			<array>
				<string>public.utf8-plain-text</string>
			</array>
			<key>NSRequiredContext</key>
			<dict/>
		</dict>
		<dict>
			<key>NSMenuItem</key>
			<dict>
				<key>default</key>
				<string>Copy as SecureSend link</string>
			</dict>
			<key>NSMessage</key>
			<string>copyToClipboard</string>
			<key>NSPortName</key>
			<string>SecureSend</string>
			<key>NSSendTypes</key>
			<array>
				<string>public.utf8-plain-text</string>
			</array>
			<key>NSRequiredContext</key>
			<dict/>
		</dict>
		<!-- Files picked in Finder.

		     Named apart from the text service above rather than sharing its
		     wording. Only one of the two is ever offered at a time, since a
		     selection is either text or files, but they are both in the Services
		     list in System Settings that the README sends people to for a keyboard
		     shortcut, and two rows reading the same thing there is a choice nobody
		     can make. Plural whatever the count, the way Finder's own entries are.

		     public.data rather than public.item, so the service is offered for
		     files and not for folders or packages. A folder is not one file with a
		     size, and this app does not archive anything. NSSendFileTypes is the
		     whole registration: the pasteboard that arrives carries file urls. -->
		<dict>
			<key>NSMenuItem</key>
			<dict>
				<key>default</key>
				<string>Copy files as SecureSend link</string>
			</dict>
			<key>NSMessage</key>
			<string>copyFilesToClipboard</string>
			<key>NSPortName</key>
			<string>SecureSend</string>
			<key>NSSendFileTypes</key>
			<array>
				<string>public.data</string>
			</array>
			<key>NSRequiredContext</key>
			<dict/>
		</dict>
	</array>
</dict>
</plist>
